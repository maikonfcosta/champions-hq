rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regra padrão: negar tudo por segurança
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Usuários só podem ler e escrever seus próprios dados
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Desafios globais: leitura pública para qualquer usuário
    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if false; // Gerenciado via console/admin
    }

    // Leaderboards de desafios: leitura pública de rankings e submissão individual por usuário autenticado
    match /leaderboards/{challengeId}/entries/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
